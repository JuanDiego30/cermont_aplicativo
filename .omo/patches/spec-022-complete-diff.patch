+# Cermont Production Nginx Config
+# Reverse proxy for backend (4000) and frontend (3000)
+
+upstream backend {
+    server 127.0.0.1:4000;
+    keepalive 64;
+}
+
+upstream frontend {
+    server 127.0.0.1:3000;
+    keepalive 64;
+}
+
+server {
+    listen 80;
+    server_name app.cermont.com.co;
+    return 301 https://$server_name$request_uri;
+}
+
+server {
+    listen 443 ssl http2;
+    server_name app.cermont.com.co;
+
+    ssl_certificate /etc/ssl/certs/cermont.crt;
+    ssl_certificate_key /etc/ssl/private/cermont.key;
+    ssl_protocols TLSv1.2 TLSv1.3;
+    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
+
+    # Security headers
+    add_header X-Frame-Options "SAMEORIGIN" always;
+    add_header X-Content-Type-Options "nosniff" always;
+    add_header X-XSS-Protection "1; mode=block" always;
+    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
+
+    # Backend API
+    location /api/ {
+        proxy_pass http://backend;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_read_timeout 60s;
+        proxy_send_timeout 60s;
+    }
+
+    # Frontend
+    location / {
+        proxy_pass http://frontend;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header Upgrade $http_upgrade;
+        proxy_set_header Connection "upgrade";
+        proxy_read_timeout 60s;
+    }
+
+    # Static files caching
+    location /_next/static {
+        proxy_pass http://frontend;
+        expires 365d;
+        add_header Cache-Control "public, immutable";
+    }
+
+    location /static {
+        alias /app/frontend/public/static;
+        expires 30d;
+        add_header Cache-Control "public";
+    }
+
+    # Large upload support
+    client_max_body_size 50M;
+}
