+  verifiedAt?: Date;
+  metadata: {
+    capturedBy: string;
+    capturedAt: Date;
+    coordinates?: { lat: number; lng: number };
+    deviceInfo?: string;
+    originalSizeKB: number;
+    compressedSizeKB: number;
+  };
+}
+```
