+			"PowerShell(npm run verify 2>&1 | Select-Object -Last 10; \"VERIFY EXIT: $LASTEXITCODE\")",
+			"PowerShell(npm run test:e2e 2>&1 | Select-Object -Last 30; \"E2E EXIT: $LASTEXITCODE\")",
+			"PowerShell(docker ps --format \"table {{.Names}}\\\\t{{.Status}}\"; docker compose config --quiet 2>&1; \"CONFIG: $LASTEXITCODE\"; docker manifest inspect mongo:7.0-alpine 2>&1 | Select-Object -First 3)"
+		]
+	}
