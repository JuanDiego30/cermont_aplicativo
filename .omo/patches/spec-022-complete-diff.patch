+"EXECUTION_ALREADY_STARTED"
+"EXECUTION_NOT_STARTED"
+"EXECUTION_ALREADY_FINISHED"
+
+// Documents
+"DOCUMENT_IMPORT_NOT_FOUND"
+"DOCUMENT_IMPORT_UNSUPPORTED_FILE_TYPE"
+"DOCUMENT_TEMPLATE_VERSION_IMMUTABLE"
+
+// Costs
+"COST_CART_NOT_FOUND"
