+  updatedAt: { type: Date, default: Date.now },
+})
+
+WorkRequestSchema.index({ status: 1, createdAt: -1 })
+WorkRequestSchema.index({ clientId: 1 })
+WorkRequestSchema.index({ siteId: 1 })
