 backend/src/modules/resource/resource.routes.ts | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/backend/src/modules/resource/resource.routes.ts b/backend/src/modules/resource/resource.routes.ts
index b40334e..4546111 100644
--- a/backend/src/modules/resource/resource.routes.ts
