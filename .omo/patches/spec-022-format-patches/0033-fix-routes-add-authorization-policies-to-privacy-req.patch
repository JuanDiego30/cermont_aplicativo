diff --git a/packages/shared-types/src/schemas/privacy-request.schema.ts b/packages/shared-types/src/schemas/privacy-request.schema.ts
new file mode 100644
index 0000000..81bbb34
--- /dev/null
+++ b/packages/shared-types/src/schemas/privacy-request.schema.ts
@@ -0,0 +1,25 @@
+import { z } from "zod";
+import { ObjectIdSchema } from "./common.schema";
+
+export const PrivacyRequestTypeSchema = z.enum([
+	"access",
+	"rectification",
+	"erasure",
+	"restriction",
+	"portability",
+]);
+
+export const CreatePrivacyRequestSchema = z
+	.object({
+		type: PrivacyRequestTypeSchema,
+		description: z.string().min(1).max(2000),
+	})
+	.strict();
+
+export type CreatePrivacyRequestInput = z.infer<typeof CreatePrivacyRequestSchema>;
+
+export const PrivacyRequestIdParamsSchema = z
+	.object({
+		id: ObjectIdSchema,
+	})
+	.strict();
