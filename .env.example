# ─────────────────────────────────────────────────────────────────────────────
# CERMONT S.A.S. — Variables de entorno para Docker Compose
#
# Uso:
#   cp .env.example .env
#   docker compose up -d --build
#
# Para producción: generar secretos con openssl rand -hex 32
# Ver: docs/deploy/VARIABLES_ENTORNO.md
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB (requeridas) ──────────────────────────────────────────────────────
MONGO_ROOT_USER=cermont_admin
MONGO_ROOT_PASSWORD=cermont_demo_password_change_me

# ── JWT (requeridas) ──────────────────────────────────────────────────────────
# Producción: openssl rand -hex 32
JWT_SECRET=demo_jwt_secret_change_in_production_min_32_chars_1234567890
REFRESH_TOKEN_SECRET=demo_refresh_secret_change_in_production_min_32_chars_12345

# ── Opcionales (tienen defaults en docker-compose.yml) ───────────────────────
# URL pública del servidor (para API calls desde el navegador)
# Cambiar <IP_DEL_SERVIDOR> por la IP real del VPS o dominio
# NEXT_PUBLIC_API_URL=http://<IP_DEL_SERVIDOR>/api
# NEXT_PUBLIC_APP_URL=http://<IP_DEL_SERVIDOR>

# Seed automático al primer arranque (demo: true, producción: false)
# SEED_ON_START=true
# SEED_DEFAULT_PASSWORD=Cermont2026!

# Logging
# LOG_LEVEL=info
