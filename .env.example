# ─────────────────────────────────────────────────────────────────────────────
# CERMONT S.A.S. — Variables de entorno para DESARROLLO LOCAL
#
# Uso:
#   cp .env.example .env         (solo si necesitas Docker Compose)
#   cp .env.docker.example .env  (para Docker Compose / VPS)
#
# Para desarrollo local NO necesitas copiar este archivo. El frontend usa
# frontend/.env.local y el backend usa backend/.env. Ver:
#   docs/development/LOCAL_DEVELOPMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB (solo necesarias si usas Docker Compose para MongoDB) ────────────
MONGO_ROOT_USER=cermont_admin
MONGO_ROOT_PASSWORD=cermont_dev_password

# ── JWT (valores para desarrollo — generar nuevos en producción) ────────────
JWT_SECRET=dev_jwt_secret_min_32_chars_change_in_production_1234567890
REFRESH_TOKEN_SECRET=dev_refresh_secret_min_32_chars_change_in_production_12345

# ── Backend URL (para Docker Compose) ───────────────────────────────────────
# El frontend proxy usa BACKEND_URL. En desarrollo local con npm run dev,
# el frontend/.env.local tiene BACKEND_URL=http://127.0.0.1:4000.
# En Docker Compose se inyecta BACKEND_URL con el hostname interno de Docker.
# BACKEND_URL=http://localhost:4000

# ── Opcionales ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# LOG_LEVEL=info
# SEED_ON_START=true
# SEED_DEFAULT_PASSWORD=Cermont2026!
