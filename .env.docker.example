# ──────────────────────────────────────────────────────────────────────────────
# Docker Compose Environment Variables — CERMONT S.A.S.
# Copy this file to .env at the root of the monorepo before running
#   docker compose up
# Generate secrets with: openssl rand -hex 64
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUERIDOS (docker compose fallará sin estos) ────────────────────────────
# Usuario raíz de MongoDB — cambiar en producción
MONGO_ROOT_USER=cermont_admin
# Contraseña raíz de MongoDB — CAMBIAR EN PRODUCCIÓN (mínimo 16 caracteres)
# Generar con: openssl rand -hex 32
MONGO_ROOT_PASSWORD=cermont_secure_password_change_me_in_production

# JWT Secret para tokens de autenticación
# Generar con: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_min_32_chars_change_in_production_12345678

# Secret para refresh tokens
# Generar con: openssl rand -hex 64 (DIFERENTE del JWT_SECRET)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars_change_production_87654321

# ── OPCIONALES (tienen valores por defecto sensatos) ─────────────────────────
# Entorno de ejecución
NODE_ENV=production

# URL pública del frontend (para CORS en backend y redirects)
# Con nginx en puerto 8081: http://localhost:8081
# En producción: https://app.cermont.com
FRONTEND_URL=http://localhost:3000

# URL del API vista desde el navegador cliente (a través del proxy de nginx)
# En local: http://localhost:8081/api
# En producción: https://api.cermont.com/api
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# URL pública de la aplicación frontend (para Open Graph, PWA, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME=Cermont S.A.S.

# ── JWT Configuration ────────────────────────────────────────────────────────
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Logging & Monitoring ─────────────────────────────────────────────────────
# Niveles: debug, info, warn, error
LOG_LEVEL=info

# ── File Upload Configuration ────────────────────────────────────────────────
# En Docker Compose, el backend recibe /app/uploads (volumen persistente)
# En desarrollo local, usar ./uploads
UPLOAD_DIR=/app/uploads
# Tamaño máximo de archivo en bytes (52428800 = 50MB)
MAX_FILE_SIZE=52428800

# ── Database Configuration ───────────────────────────────────────────────────
# URI de conexión a MongoDB (el backend la arma si se omite, usando MONGO_ROOT_* vars)
# Dentro de Docker: mongodb://user:pass@mongodb:27017/cermont?authSource=admin
# En desarrollo local: mongodb://localhost:27017/cermont
MONGODB_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@mongodb:27017/cermont?authSource=admin&retryWrites=true&w=majority

# ── NextJS Telemetry ─────────────────────────────────────────────────────────
# Desabilitar telemetría anónima de Next.js
NEXT_TELEMETRY_DISABLED=1

# ── CORS Configuration ───────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:3000,http://localhost:8081
# Descomentar si es necesario definir CORS explícitamente

# ── Feature Flags ────────────────────────────────────────────────────────────
# FEATURE_X_ENABLED=false
# Descomentar según necesidad

# ── Email Configuration (si es necesario) ───────────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=onboarding@resend.dev
# SMTP_PASS=your_password
# SMTP_FROM=noreply@cermont.com
