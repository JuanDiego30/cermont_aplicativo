# ──────────────────────────────────────────────────────────────────────────────
# Docker Compose Environment Variables — CERMONT S.A.S.
# Copy this file to .env at the root of the monorepo before running
#   docker compose up
# Generate secrets with: openssl rand -hex 64
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUERIDOS (docker compose fallara sin estos) ────────────────────────────
# Valores de ejemplo para validar configuracion. Reemplazar todos en produccion.
MONGO_ROOT_USER=cermont_admin
# Contraseña raiz de MongoDB (minimo 16 caracteres)
# Generar con: openssl rand -hex 32
MONGO_ROOT_PASSWORD=cermont_secure_password_change_me_in_production

# JWT Secret para tokens de autenticación
# Generar con: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_min_32_chars_change_in_production_12345678

# Secret para refresh tokens
# Generar con: openssl rand -hex 64 (DIFERENTE del JWT_SECRET)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars_change_production_87654321

# Origen publico exacto permitido por CORS
FRONTEND_URL=https://app.example.com

# ── BUILD DEL FRONTEND ───────────────────────────────────────────────────────
# Estas variables quedan incorporadas durante docker compose build.
NEXT_PUBLIC_API_URL=https://app.example.com/api
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_APP_NAME=Cermont S.A.S.

# ── OPCIONALES ───────────────────────────────────────────────────────────────
# Entorno de ejecución
NODE_ENV=production

# El host termina TLS y reenvia al nginx interno.
NGINX_PORT=127.0.0.1:8081

# ── JWT Configuration ────────────────────────────────────────────────────────
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Logging & Monitoring ─────────────────────────────────────────────────────
# Niveles: debug, info, warn, error
LOG_LEVEL=info

# ── File Upload Configuration ────────────────────────────────────────────────
# En Docker Compose, el backend recibe /app/uploads (volumen persistente)
# En desarrollo local, usar ./uploads
UPLOAD_DIR=/app/uploads
# Tamaño máximo de archivo en bytes (52428800 = 50MB)
MAX_FILE_SIZE=52428800

# ── NextJS Telemetry ─────────────────────────────────────────────────────────
# Desabilitar telemetría anónima de Next.js
NEXT_TELEMETRY_DISABLED=1

# ── CORS Configuration ───────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:3000,http://localhost:8081
# Descomentar si es necesario definir CORS explícitamente

# ── Feature Flags ────────────────────────────────────────────────────────────
# FEATURE_X_ENABLED=false
# Descomentar según necesidad

# ── Seed manual ──────────────────────────────────────────────────────────────
# No se define en el runtime normal. Inyectar solo al ejecutar el seed:
# SEED_DEFAULT_PASSWORD=replace_with_at_least_16_characters

# ── Email Configuration (si es necesario) ───────────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=onboarding@resend.dev
# SMTP_PASS=your_password
# SMTP_FROM=noreply@cermont.com
