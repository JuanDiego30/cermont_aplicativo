# ──────────────────────────────────────────────────────────────────────────────
# Docker Compose Environment Variables — CERMONT S.A.S.
# Copy this file to .env at the root of the monorepo before running
#   docker compose up
# Generate secrets with: openssl rand -hex 64
# ──────────────────────────────────────────────────────────────────────────────

# ── Required (docker compose will fail without these) ─────────────────────────
MONGO_ROOT_USER=cermont_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_run_openssl_rand_hex_64_min_16_chars
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_64
REFRESH_TOKEN_SECRET=CHANGE_ME_run_openssl_rand_hex_64_different

# ── Optional (have sensible defaults) ─────────────────────────────────────────
NODE_ENV=development
MONGODB_URI=mongodb://cermont_admin:${MONGO_ROOT_PASSWORD}@mongodb:27017/cermont?authSource=admin
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
LOG_LEVEL=info
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
