# Frontend .gitignore
# ==========================================
# Next.js Build Output
# ==========================================
.next/
out/
build/
.vercel/

# Environment Variables
.env
.env.local
.env.*.local
!.env.example

# Storybook
storybook-static/

# Testing
coverage/
test-results/
playwright-report/

# TypeScript Cache
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Misc
*.pem
*.key
*.crt

# ==========================================
# GENERATED ARTIFACTS — BUG-6 Fix
# ==========================================
# Ignore all TypeScript declaration files in source (generated by tsc/orval)
src/**/*.d.ts
# But keep handwritten ambient declarations in src/types/
!src/types/*.d.ts

# Ignore all generated JavaScript files in source (except essential configs)
src/**/*.js
!next.config.js
!postcss.config.mjs

# TypeScript build info (already partially covered)
*.tsbuildinfo

# Legacy build/test output logs
tsc_output.txt
typecheck_output.txt
results.txt
