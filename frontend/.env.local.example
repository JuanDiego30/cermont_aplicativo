# Frontend Environment Variables
# Copy this file to .env.local and fill in your values
# Reference: docs/Intrucciones_para_crear_app_web/DOC-04 (JWT + Zustand auth)
# Reference: docs/Intrucciones_para_crear_app_web/DOC-05 (Frontend stack)
#
# Note: NextAuth.js is NOT used (using JWT + Zustand + httpOnly cookies instead)

# Application Configuration
NEXT_PUBLIC_APP_NAME=Cermont S.A.S.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring (optional - Sentry for error tracking)
# Reference: https://sentry.io/
# NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags (optional)
# NEXT_PUBLIC_FEATURE_MFA_ENABLED=false

# Cermont AI — enable AI assistant in sidebar
# NEXT_PUBLIC_ENABLE_CERMONT_AI=false

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ SECURITY NOTES:
# - All NEXT_PUBLIC_* variables are exposed to browser — NO secrets here
# - Backend secrets are in apps/backend/.env
# - In production:
#   - NEXT_PUBLIC_API_URL: Use HTTPS backend URL
#   - NEXT_PUBLIC_APP_URL: Use HTTPS frontend URL
#   - Store sensitive config in environment (not in .env files)
# ─────────────────────────────────────────────────────────────────────────────
