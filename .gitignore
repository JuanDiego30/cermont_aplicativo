# ==========================================
# Cermont Monorepo — .gitignore
# Maintainer: Keep this file lean. Add rules only when truly needed.
# ==========================================

# ── Dependencies ──
node_modules/

# ── Environment Variables & Secrets ──
.env
.env.local
.env.*.local
!.env.example
!.env.local.example
.env.production
*.pem
*.key
*.crt
*.p12
*.pfx

# ── Next.js Frontend Build ──
frontend/.next/
frontend/out/

# ── Express Backend Build ──
backend/dist/
backend/dist-tsc/
backend/*.tsbuildinfo

# ── Backend Runtime Files ──
backend/uploads/
backend/temp/
backend/logs/
backend/reports/
backend/exports/

# ── Packages Build ──
packages/*/dist/

# ── Testing & Coverage ──
coverage/
.nyc_output/
playwright-report/
test-results/

# ── Build Caches ──
.turbo/
*.tsbuildinfo
.next/
out/
dist/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*

# ── OS & IDE Metadata ──
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ── Agent Tool Metadata (not part of project) ──
# Keep only: .agents/ .github/ .husky/ .gemini/ .claude/ .vscode/
.adal/
.antigravity/
.antigravitycli/
.augment/
.bob/
.codebuddy/
.codex/
.commandcode/
.continue/
.copilot/
.cortex/
.crush/
.cursor/
.cursor-ai/
.factory/
.gemini/
.goose/
.iflow/
.junie/
.kilo/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.obsidian/
.opencode/
.openhands/
.pi/
.playwright-cli/
.playwright-mcp/
.pochi/
.qoder/
.qwen/
.react-doctor/
.roo/
.sisyphus/
.trae/
.vibe/
.windsurf/
.worktrees/
.zed/
.zencoder/

# ── Misc Forbidden Files ──
pnpm-lock.yaml
yarn.lock
*.exe
*.py
data/
scratch/
tmp/
*.tmp
*.temp

# ── Package config files — MUST be versioned (negations) ──
!package.json
!package-lock.json
!turbo.json
!tsconfig.json
!tsconfig.base.json
!biome.json
!backend/package.json
!backend/tsconfig.json
!frontend/package.json
!frontend/tsconfig.json
!packages/*/package.json
!packages/*/tsconfig.json
!packages/shared-types/contracts/*.json
!*.snapshot.json

# ── PWA assets — MUST be versioned ──
!frontend/public/icons/*.png
!frontend/public/manifest.json
!frontend/public/robots.txt

# ── Legacy prevention ──
/apps/backend/
/apps/frontend/
/apps/packages/
