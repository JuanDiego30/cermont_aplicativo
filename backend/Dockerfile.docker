# Dockerfile.docker - Optimizado para Docker Compose
# Estrategia simple: llevar todo del builder

FROM node:22-alpine AS builder
WORKDIR /app

# Copiar manifests del workspace
COPY package.json package-lock.json ./
COPY packages/config/package.json packages/config/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY backend/package.json backend/package.json

# Copiar todo el código
COPY packages/ packages/
COPY backend backend/

# Instalar dependencias
RUN npm ci --include-workspace-root --workspaces --ignore-scripts

# Compilar shared-types
WORKDIR /app/packages/shared-types
RUN npm run build

# Compilar domain
WORKDIR /app/packages/domain
RUN npm run build

# Compilar backend
WORKDIR /app/backend
RUN npm run build

# ============================================================================
# Runtime
# ============================================================================
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache dumb-init curl

ENV PORT=4000 \
    NODE_ENV=production

EXPOSE 4000

# Usuario no-root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S expressjs -u 1001

# Copiar TODO desde builder
COPY --from=builder --chown=expressjs:nodejs /app ./

# Crear carpetas necesarias con permisos correctos (antes de cambiar usuario)
RUN mkdir -p /app/uploads && chown -R expressjs:nodejs /app/uploads

USER expressjs

WORKDIR /app

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:4000/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "backend/dist/server.js"]
