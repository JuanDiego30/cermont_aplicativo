# Backend Environment Variables
# Copy this file to .env and fill in your values
# Reference: docs/Intrucciones_para_crear_app_web/DOC-04 (Security + JWT)
#
# ⚠️ CRITICAL: All secrets must be changed for production
# Use: openssl rand -hex 32 to generate secure keys

# Server Configuration
NODE_ENV=development
PORT=4000

# Database (MongoDB)
MONGO_ROOT_USER=change_me_dbuser
MONGO_ROOT_PASSWORD=change_me_STRONG_PASSWORD_min_16_chars
MONGODB_URI=mongodb://127.0.0.1:27017/cermont

# Seed script password
SEED_DEFAULT_PASSWORD=change_me_seed_password_min_16_chars

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-secret-key-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS - Frontend URL
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
CLAMAV_ENABLED=false

# Logging
LOG_LEVEL=info
BCRYPT_ROUNDS=12

# CORS — Production origins (comma-separated)
CORS_ORIGINS=https://cermontsas.shop,https://www.cermontsas.shop
API_URL=https://api.cermontsas.shop
COOKIE_SECURE=true

# ─────────────────────────────────────────────────────────────────────────────
# Email Configuration (Password Recovery)
# ─────────────────────────────────────────────────────────────────────────────
#
# Provider options:
#   smtp     — Production SMTP (requires EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS)
#   mailpit  — Development sandbox (default host localhost:1025, no auth)
#   log      — Development only, logs to console (NOT allowed in production)
#
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@cermont.com.co
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
